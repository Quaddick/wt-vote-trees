# Скопируй этот файл в .env рядом с docker-compose.yml и заполни.

# Пароль для входа в режим правки (кнопка «Вход»). Пусто — сайт только для просмотра.
ADMIN_PASSWORD=

# Секрет подписи сессий: openssl rand -hex 32. Пусто — после перезапуска придётся входить заново.
SESSION_SECRET=

# Адрес nginx, которому верить в X-Forwarded-For (docs/DEPLOY.md, раздел 4). Без nginx — оставь пустым.
TRUSTED_PROXIES=
